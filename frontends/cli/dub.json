{
    "name": "cli-frontend",
    "targetType": "executable",
    "targetPath": "../../bin/",
    "targetName": "sideloader",

    "sourcePaths": [
        "source/"
    ],

    "//": "One file, not the whole ../common/windows/ directory: graphical_app.d there carries a /SUBSYSTEM:WINDOWS linker directive, which would leave the CLI without a console.",
    "sourceFiles-windows": [
        "../common/windows/dllsearch.d"
    ],

    "dependencies": {
        "sideloader": { "path": "../../" },
        "argparse": "~>1.3.0",
        "progress": "~>5.0.2",
        "slf4d": "~>2"
    },
    "dflags-ldc": [
        "--link-defaultlib-shared=false"
    ],

    "dflags-gdc": [
        "-defaultlib=:libgphobos.a"
    ]
}