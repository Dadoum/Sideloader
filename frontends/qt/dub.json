    ],

    "dependencies": {
        "sideloader": { "path": "../../" },
        "dqt": {
            "repository": "git+https://github.com/tim-dlang/dqt.git",
            "version": "82213e7a72afc1cee845a032e71e25b4c957ddc2"
        }
    }
}