{
    "name": "qt-frontend",
    "targetType": "executable",
    "targetPath": "../../bin/",
    "targetName": "sideloader",
    "versions": ["Qt"],

    "sourcePaths": [
        "source/"
    ],

    "sourcePaths-linux": [
        "../common/linux/"
