                      </widget>
                     </item>
                    </layout>
                   </widget>
                  </item>
                  <item>
                   <!-- Install log: newest line on top, older ones dim out
                        and are dropped. Filled from code. The card has a
                        fixed minimum height so the layout does not jump as
