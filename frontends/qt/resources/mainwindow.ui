                  <item>
                   <layout class="QHBoxLayout" name="horizontalLayout_2">
                    <property name="spacing"><number>10</number></property>
                    <item>
                     <widget class="QLineEdit" name="ipaLine">
                      <!-- Keep .ui strings ASCII-only: dqt hands the literal
                           to QString without decoding UTF-8, so any accent or
                           typographic character comes out as mojibake. -->
                      <property name="placeholderText"><string>Select an .ipa package...</string></property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QToolButton" name="selectIpaButton">
                      <!-- Leading spaces are the icon-to-text gap: Qt exposes
                           no spacing property for this in QSS. -->
                      <property name="text"><string>  Browse</string></property>
                      <property name="toolButtonStyle"><enum>Qt::ToolButtonTextBesideIcon</enum></property>
                     </widget>
                    </item>
                   </layout>
