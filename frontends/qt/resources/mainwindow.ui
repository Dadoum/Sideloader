  <!-- The menu bar stays to own the QActions but is hidden: the hamburger
       button in the title bar republishes those same menus in a popup. -->
  <widget class="QMenuBar" name="menubar">
   <widget class="QMenu" name="menuFile">
    <property name="title"><string>Account</string></property>
    <addaction name="actionAccountStatus"/>
    <addaction name="separator"/>
    <addaction name="actionLog_in"/>
    <addaction name="actionSign_out"/>
    <addaction name="separator"/>
    <addaction name="actionManage_App_IDs"/>
    <addaction name="actionManage_certificates"/>
   </widget>
   <widget class="QMenu" name="menuDevices">
    <property name="title"><string>Devices</string></property>
    <addaction name="actionRefresh_device_list"/>
   </widget>
   <widget class="QMenu" name="menuHelp">
    <property name="title"><string>Help</string></property>
    <addaction name="actionDonate"/>
    <addaction name="actionAbout"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuDevices"/>
   <addaction name="menuHelp"/>
  </widget>
  <!-- Disabled on purpose: this entry is a status line, not a command. -->
  <action name="actionAccountStatus">
   <property name="enabled"><bool>false</bool></property>
   <property name="text"><string>Not signed in</string></property>
  </action>
  <action name="actionLog_in">
   <property name="text"><string>Sign in...</string></property>
   <property name="toolTip"><string>Sign in to Apple now, without starting an install</string></property>
  </action>
  <action name="actionSign_out">
   <property name="text"><string>Sign out</string></property>
   <property name="toolTip"><string>Forget the saved Apple session</string></property>
  </action>
  <action name="actionManage_App_IDs">
   <property name="text"><string>Manage App IDs</string></property>
  </action>
  <action name="actionManage_certificates">
   <property name="text"><string>Manage certificates</string></property>
  </action>
  <action name="actionRefresh_device_list">
   <property name="text"><string>Refresh device list</string></property>
  </action>
  <action name="actionDonate">
   <property name="text"><string>Donate</string></property>
  </action>
  <action name="actionAbout">
